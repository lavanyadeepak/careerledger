# ResumeTracker environment variables

# Backend
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_URL="postgresql://resumetracker:resumetracker@localhost:5432/resumetracker?schema=public"

# Microsoft Graph
MS_GRAPH_CLIENT_ID=your-azure-client-id
MS_GRAPH_CLIENT_SECRET=your-azure-client-secret
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/graph/callback
MS_GRAPH_SENDER_EMAIL=your-email@domain.com
MS_GRAPH_SCOPES=Mail.Send User.Read offline_access

# File storage
RESUME_UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE=10485760

# Encryption
ENCRYPTION_KEY=change-me-32-chars