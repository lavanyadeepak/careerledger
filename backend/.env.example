# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Database (PostgreSQL 16+)
DATABASE_URL="postgresql://resumetracker:resumetracker@localhost:5432/resumetracker?schema=public"

# Microsoft Graph API (OAuth2 client credentials / auth code flow)
MS_GRAPH_CLIENT_ID=your-azure-ad-app-client-id
MS_GRAPH_CLIENT_SECRET=your-azure-ad-app-client-secret
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback
MS_GRAPH_SENDER_EMAIL=your-email@domain.com
MS_GRAPH_SCOPES=Mail.Send User.Read offline_access

# MailGun API (alternative email sending)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-verified-mailgun-domain
MAIL_FROM=your@sender.com

# File Storage
RESUME_UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE=10485760

# Encryption (for storing OAuth tokens)
ENCRYPTION_KEY=your-32-char-encryption-key-change-me